{
  "name": "yap",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test && bun run test:tools",
    "lint": "oxlint apps packages scripts helpers evals",
    "format": "oxfmt --write apps packages scripts helpers evals package.json turbo.json tsconfig.base.json",
    "format:check": "oxfmt --check apps packages scripts helpers evals package.json turbo.json tsconfig.base.json",
    "lab:bootstrap": "node packages/test-harness/dist/bootstrap.js",
    "lab:client-image": "node packages/test-harness/dist/client-image.js",
    "lab:speech-eval": "node scripts/speech-eval.mjs",
    "lab:speech-boundaries": "node packages/test-harness/speech-boundaries.mjs",
    "lab:workbench": "bun run --cwd apps/workbench dev",
    "lab:capture": "node scripts/native-capture-probe.mjs",
    "lab:recovery": "node apps/macos/tests/recovery-lab.mjs",
    "lab:av-sync": "node packages/test-harness/av-sync.mjs",
    "lab:cursor-geometry": "node scripts/cursor-geometry-lab.mjs",
    "yap": "node apps/cli/dist/main.js",
    "eval:agents": "node evals/run.mjs",
    "eval:test": "node --test evals/*.test.mjs",
    "install:personal": "bun run build && node scripts/install-personal.mjs",
    "signing-identity": "node scripts/signing-identity.mjs",
    "lab:index-scale": "bun run --cwd packages/test-harness lab:index-scale",
    "lab:render-timing": "bun run --cwd packages/test-harness lab:render-timing",
    "lab:pause-audio": "bun run --cwd packages/test-harness lab:pause-audio",
    "lab:exports": "bun run build && bun run --cwd packages/test-harness lab:exports",
    "lab:personal-release": "node packages/test-harness/personal-release.mjs",
    "test:tools": "node --test scripts/*.test.mjs presets/kit/*.test.mjs helpers/ffmpeg/*.test.mjs helpers/model-runtime/*.test.mjs helpers/speaker/*.test.mjs helpers/alignment/*.test.mjs && node scripts/presets-index.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "linguist-languages": "9.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.3.14",
  "lint-staged": {
    "*": "node scripts/check-file-size.mjs"
  }
}
